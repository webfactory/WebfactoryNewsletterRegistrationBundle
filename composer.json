{
    "name": "webfactory/newsletter-registration-bundle",
    "description": "Symfony-Bundle for Newsletter-Registration",
    "license": "MIT",

    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "doctrine/collections": "^2.0",
        "doctrine/orm": "^3.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/contracts": "^3.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "symfony/form": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/options-resolver": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/translation": "^8.0",
        "symfony/validator": "^8.0",
        "twig/twig": "^3.0"
    },

    "require-dev": {
        "doctrine/doctrine-bundle": "^3.0",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/yaml": "^8.0",
        "zenstruck/foundry": "^2.8"
    },

    "autoload": {
        "psr-4": {
            "Webfactory\\NewsletterRegistrationBundle\\": "src"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/Fixtures/App",
            "AppBundle\\Newsletter\\Entity\\": "Resources/app-class-templates",
            "Webfactory\\NewsletterRegistrationBundle\\Tests\\": "tests"
        }
    },

    "config": {
        "sort-packages": true
    }
}
